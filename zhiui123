        function Elements:AddSlider(text, min, max, default, callback)
            local SFrame = Instance.new("Frame", Page)
            SFrame.Size = UDim2.new(0.95, 0, 0, 55); SFrame.BackgroundColor3 = Theme.ElementBg; SFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", SFrame).CornerRadius = UDim.new(0, 8)

            local L = Instance.new("TextLabel", SFrame)
            L.Size = UDim2.new(0.7, 0, 0, 25); L.Position = UDim2.fromOffset(12, 4); L.BackgroundTransparency = 1
            L.Text = text; L.TextColor3 = Theme.Text; L.Font = "GothamBold"; L.TextSize = 13; L.TextXAlignment = "Left"
            
            local ValLabel = Instance.new("TextLabel", SFrame)
            ValLabel.Size = UDim2.new(0.25, 0, 0, 25); ValLabel.Position = UDim2.new(1, -100, 0, 4); ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(default); ValLabel.TextColor3 = Theme.Accent; ValLabel.Font = "GothamBold"; ValLabel.TextSize = 13; ValLabel.TextXAlignment = "Right"

            local Bar = Instance.new("TextButton", SFrame)
            Bar.Size = UDim2.new(0.92, 0, 0, 5); Bar.Position = UDim2.new(0.04, 0, 0, 38); Bar.BackgroundColor3 = Color3.fromRGB(60, 60, 62); Bar.Text = ""
            Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)
            
            local Fill = Instance.new("Frame", Bar); Fill.Size = UDim2.fromScale(math.clamp((default-min)/(max-min), 0, 1), 1); Fill.BackgroundColor3 = Theme.Accent
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local dragging = false
            local function UpdateSlider()
                if not dragging then return end
                local mousePos = UserInputService:GetMouseLocation().X
                local barPos = Bar.AbsolutePosition.X
                local barWidth = Bar.AbsoluteSize.X
                local p = math.clamp((mousePos - barPos) / barWidth, 0, 1)
                Fill.Size = UDim2.fromScale(p, 1)
                local res = math.floor(min + (max - min) * p)
                ValLabel.Text = tostring(res)
                callback(res)
            end
            
            Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true UpdateSlider() end end)
            UserInputService.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then UpdateSlider() end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
        end

        function Elements:AddDropdown(text, list, callback)
            local DFrame = Instance.new("Frame", Page)
            DFrame.Size = UDim2.new(0.95, 0, 0, 45); DFrame.BackgroundColor3 = Theme.ElementBg; DFrame.BackgroundTransparency = 0.2; DFrame.ClipsDescendants = true
            Instance.new("UICorner", DFrame).CornerRadius = UDim.new(0, 8)

            local Btn = Instance.new("TextButton", DFrame)
            Btn.Size = UDim2.new(1, 0, 0, 45); Btn.BackgroundTransparency = 1; Btn.Text = "  " .. text .. " : 选择中..."; Btn.TextColor3 = Theme.Text; Btn.Font = "GothamBold"; Btn.TextSize = 14; Btn.TextXAlignment = "Left"

            local OptionsContainer = Instance.new("Frame", DFrame)
            OptionsContainer.Position = UDim2.fromOffset(0, 45); OptionsContainer.Size = UDim2.new(1, 0, 1, -45); OptionsContainer.BackgroundTransparency = 1
            local DropLayout = Instance.new("UIListLayout", OptionsContainer); DropLayout.Padding = UDim.new(0, 2)

            local dropped = false
            Btn.MouseButton1Click:Connect(function()
                dropped = not dropped
                TweenService:Create(DFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = dropped and UDim2.new(0.95, 0, 0, 45 + (#list * 32) + 5) or UDim2.new(0.95, 0, 0, 45)}):Play()
            end)

            for i, v in ipairs(list) do
                local opt = Instance.new("TextButton", OptionsContainer)
                opt.Size = UDim2.new(0.96, 0, 0, 30); opt.Position = UDim2.fromOffset(10, 0)
                opt.BackgroundTransparency = 0.9; opt.BackgroundColor3 = Color3.fromRGB(255,255,255); opt.Text = "   " .. tostring(v); opt.TextColor3 = Theme.TextSecondary; opt.Font = "Gotham"; opt.TextXAlignment = "Left"; opt.TextSize = 13
                Instance.new("UICorner", opt).CornerRadius = UDim.new(0, 4)
                opt.MouseButton1Click:Connect(function()
                    Btn.Text = "  " .. text .. " : " .. tostring(v); dropped = false
                    TweenService:Create(DFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0.95, 0, 0, 45)}):Play()
                    callback(v)
                end)
            end
        end

        function Elements:AddInput(text, placeholder, callback)
            local IFrame = Instance.new("Frame", Page)
            IFrame.Size = UDim2.new(0.95, 0, 0, 45); IFrame.BackgroundColor3 = Theme.ElementBg; IFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", IFrame).CornerRadius = UDim.new(0, 8)

            local L = Instance.new("TextLabel", IFrame)
            L.Size = UDim2.new(0.4, 0, 1, 0); L.Position = UDim2.fromOffset(12, 0); L.BackgroundTransparency = 1; L.Text = text; L.TextColor3 = Theme.Text; L.Font = "GothamBold"; L.TextSize = 14; L.TextXAlignment = "Left"

            local B = Instance.new("TextBox", IFrame)
            B.Size = UDim2.new(0.5, 0, 0, 28); B.Position = UDim2.new(1, -12, 0.5, 0); B.AnchorPoint = Vector2.new(1, 0.5); B.BackgroundColor3 = Color3.fromRGB(48, 48, 50); B.Text = ""; B.PlaceholderText = placeholder; B.TextColor3 = Theme.Text; B.Font = "Gotham"; B.TextSize = 13; Instance.new("UICorner", B).CornerRadius = UDim.new(0, 6)
            local BStroke = Instance.new("UIStroke", B); BStroke.Color = Color3.fromRGB(65,65,65); BStroke.Thickness = 1
            B.FocusLost:Connect(function(e) if e then callback(B.Text) end end)
        end

        function Elements:AddLabel(text)
            local L = Instance.new("TextLabel", Page)
            L.Size = UDim2.new(0.92, 0, 0, 25); L.BackgroundTransparency = 1; L.Text = text; L.TextColor3 = Theme.TextSecondary; L.Font = "GothamItalic"; L.TextSize = 13; L.TextXAlignment = "Left"
            return {Set = function(s, t) L.Text = t end}
        end

        function Elements:AddDivider()
            local D = Instance.new("Frame", Page)
            D.Size = UDim2.new(0.95, 0, 0, 1); D.BackgroundColor3 = Theme.Accent; D.BackgroundTransparency = 0.6
        end

        return Elements
    end
    return Lib
end

return zhiUI
