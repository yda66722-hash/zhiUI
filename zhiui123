        function Elements:AddSearchBox(placeholder)
            local SFrame = Instance.new("Frame", Page)
            SFrame.Size = UDim2.new(0.95, 0, 0, 38); SFrame.BackgroundColor3 = Theme.Sidebar; Instance.new("UICorner", SFrame).CornerRadius = UDim.new(0, 6)
            local Box = Instance.new("TextBox", SFrame)
            Box.Size = UDim2.new(1, -20, 1, 0); Box.Position = UDim2.fromOffset(10, 0); Box.BackgroundTransparency = 1; Box.Text = ""; Box.PlaceholderText = placeholder or "搜索当前页面功能..."
            Box.TextColor3 = Theme.Text; Box.Font = "Gotham"; Box.TextSize = 13; Box.TextXAlignment = "Left"
            Box:GetPropertyChangedSignal("Text"):Connect(function()
                local query = Box.Text:lower()
                for _, item in pairs(Page:GetChildren()) do
                    if item:IsA("Frame") and item ~= SFrame then
                        local lbl = item:FindFirstChildOfClass("TextLabel")
                        if lbl and lbl.Text then
                            item.Visible = (query == "" or lbl.Text:lower():find(query)) and true or false
                        end
                    end
                end
            end)
        end

        -- [2. 核心新增：创建独立浮动小按钮逻辑]
        local function CreateFloatingShortcut(name, onClickCallback, isToggle, toggleStateGet)
            local FloatFrame = Instance.new("Frame", PinGui)
            FloatFrame.Size = UDim2.fromOffset(130, 35)
            FloatFrame.BackgroundColor3 = Theme.Main
            FloatFrame.BackgroundTransparency = 0.1
            FloatFrame.Visible = not Lib.IsUIVisible -- 初始状态由主UI可见度决定
            Instance.new("UICorner", FloatFrame).CornerRadius = UDim.new(0, 6)
            
            -- 光亮特效组件
            local Glow = CreateGlowEffect(FloatFrame)

            local ActionBtn = Instance.new("TextButton", FloatFrame)
            ActionBtn.Size = UDim2.new(1, 0, 1, 0); ActionBtn.BackgroundTransparency = 1
            ActionBtn.Text = name; ActionBtn.TextColor3 = Theme.Text; ActionBtn.Font = "GothamBold"; ActionBtn.TextSize = 12

            local function RefreshGlow()
                if isToggle and toggleStateGet() then
                    -- 开启状态：触发强烈的发光特效
                    TweenService:Create(Glow, TweenInfo.new(0.3), {Thickness = 2, Transparency = 0}):Play()
                    ActionBtn.TextColor3 = Theme.Glow
                else
                    -- 关闭状态或普通按钮：无光或弱光
                    TweenService:Create(Glow, TweenInfo.new(0.3), {Thickness = 0, Transparency = 1}):Play()
                    ActionBtn.TextColor3 = Theme.Text
                end
            end

            ActionBtn.MouseButton1Click:Connect(function()
                onClickCallback()
                RefreshGlow()
            end)

            -- 针对开关类型，定时检测状态同步光亮
            if isToggle then task.spawn(function() while task.wait(0.5) do if FloatFrame and FloatFrame.Parent then RefreshGlow() end end end) end

            table.insert(Lib.PinnedElements, FloatFrame)
            return FloatFrame
        end

