local function JellyTab(obj)
    obj.MouseEnter:Connect(function()
        TweenService:Create(obj, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Size = UDim2.new(0.92, 0, 0, 42)}):Play()
    end)
    obj.MouseLeave:Connect(function()
        TweenService:Create(obj, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Size = UDim2.new(0.85, 0, 0, 40)}):Play()
    end)
end

local function JellyClick(obj)
    obj.MouseButton1Down:Connect(function()
        TweenService:Create(obj, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(0.92, 0, 0, 46)}):Play()
    end)
    obj.MouseButton1Up:Connect(function()
        TweenService:Create(obj, TweenInfo.new(0.4, Enum.EasingStyle.Elastic), {Size = UDim2.new(0.95, 0, 0, 50)}):Play()
    end)
end

local function MakeDraggable(dragPart, mainPart)
    local dragging, dragStart, startPos
    dragPart.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = mainPart.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainPart.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- 创建全局发光特效的方法
local function CreateGlowEffect(parentObj)
    local Stroke = Instance.new("UIStroke", parentObj)
    Stroke.Color = Theme.Glow
    Stroke.Thickness = 0
    Stroke.Transparency = 1
    return Stroke
end

function zhiUI:Notify(title, desc, duration)
    local NotifyGui = Parent:FindFirstChild("zhiUI_Notify")
    if not NotifyGui then
        NotifyGui = Instance.new("ScreenGui", Parent)
        NotifyGui.Name = "zhiUI_Notify"
        local Layout = Instance.new("UIListLayout", NotifyGui)
        Layout.VerticalAlignment = "Bottom"; Layout.HorizontalAlignment = "Right"; Layout.Padding = UDim.new(0, 10)
        local Padding = Instance.new("UIPadding", NotifyGui)
        Padding.PaddingBottom = UDim.new(0, 20); Padding.PaddingRight = UDim.new(0, 20)
    end

    local Notif = Instance.new("Frame", NotifyGui)
    Notif.Size = UDim2.fromOffset(0, 65); Notif.BackgroundColor3 = Theme.Main; Notif.BackgroundTransparency = 0.15
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 10)
    local Stroke = Instance.new("UIStroke", Notif); Stroke.Color = Theme.Accent; Stroke.Transparency = 0.5

    local T = Instance.new("TextLabel", Notif)
    T.Size = UDim2.new(1, -20, 0, 25); T.Position = UDim2.fromOffset(12, 6)
    T.Text = title; T.TextColor3 = Theme.Accent; T.Font = "GothamBold"; T.TextSize = 14; T.BackgroundTransparency = 1; T.TextXAlignment = "Left"

    local D = Instance.new("TextLabel", Notif)
    D.Size = UDim2.new(1, -20, 0, 30); D.Position = UDim2.fromOffset(12, 28)
    D.Text = desc; D.TextColor3 = Theme.Text; D.Font = "Gotham"; D.TextSize = 12; D.BackgroundTransparency = 1; D.TextXAlignment = "Left"; D.TextWrapped = true

    TweenService:Create(Notif, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Size = UDim2.fromOffset(280, 65)}):Play()
    task.delay(duration or 3, function()
        if Notif and Notif.Parent then
            TweenService:Create(Notif, TweenInfo.new(0.3), {Size = UDim2.fromOffset(0, 65), BackgroundTransparency = 1}):Play()
            task.wait(0.3); Notif:Destroy()
        end
    end)
end

