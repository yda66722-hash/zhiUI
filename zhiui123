        else
            TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.fromOffset(0, 0)}):Play()
            task.wait(0.3); Main.Visible = false; Mini.Visible = true
            -- 主UI隐藏时，显示所有被钉住的独立小按钮
            for _, frame in pairs(Lib.PinnedElements) do frame.Visible = true end
        end
