            Click.Size = UDim2.fromScale(1, 1)
            Click.BackgroundTransparency = 1
            Click.Text = ""
            Click.ZIndex = 7

            -- 选项面板挂在 ScreenGui 顶层, 绝对定位悬浮显示, 不占用 Page 的布局空间
            local Overlay = Instance.new("Frame", ScreenGui)
            Overlay.Name = "vsUI_DropdownOverlay"
            Overlay.BackgroundColor3 = Theme.Sidebar
            Overlay.BackgroundTransparency = 0.05
            Overlay.Visible = false
            Overlay.ZIndex = 500
            Overlay.ClipsDescendants = true
            Instance.new("UICorner", Overlay).CornerRadius = UDim.new(0, 6)
            local oStroke = Instance.new("UIStroke", Overlay)
            oStroke.Color = Theme.Accent
            oStroke.Transparency = 0.2

            local OScroll = Instance.new("ScrollingFrame", Overlay)
            OScroll.Size = UDim2.fromScale(1, 1)
            OScroll.BackgroundTransparency = 1
            OScroll.ScrollBarThickness = 3
            OScroll.ScrollBarImageColor3 = Theme.Accent
            OScroll.ZIndex = 501

            local OList = Instance.new("UIListLayout", OScroll)
            OList.SortOrder = Enum.SortOrder.LayoutOrder

            local optionHeight = 26
            local maxVisible = 6
            local selected = {}
            if default then
                if type(default) == "table" then
                    for _, v in ipairs(default) do selected[v] = true end
                else
                    selected[default] = true
                end
            end

            local function UpdateSelectedLabel()
                local names = {}
                for k, v in pairs(selected) do if v then table.insert(names, k) end end
                if #names == 0 then
                    SelectedLabel.Text = "选择..."
                elseif #names == 1 then
                    SelectedLabel.Text = names[1]
                else
                    SelectedLabel.Text = #names .. " 项已选"
                end
            end
            UpdateSelectedLabel()

            local optionButtons = {}
            local function RebuildOptions()
                for _, b in ipairs(optionButtons) do b:Destroy() end
                optionButtons = {}
                for _, opt in ipairs(list) do
                    local OBtn = Instance.new("TextButton", OScroll)
                    OBtn.Size = UDim2.new(1, 0, 0, optionHeight)
                    OBtn.BackgroundTransparency = selected[opt] and 0.6 or 1
                    OBtn.BackgroundColor3 = Theme.Accent
                    OBtn.Text = "  " .. tostring(opt)
                    OBtn.TextColor3 = Theme.Text
                    OBtn.Font = Enum.Font.Gotham
                    OBtn.TextSize = 11
                    OBtn.TextXAlignment = Enum.TextXAlignment.Left
                    OBtn.AutoButtonColor = false
                    OBtn.ZIndex = 502
                    OBtn.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt]
                            OBtn.BackgroundTransparency = selected[opt] and 0.6 or 1
                        else
                            selected = {[opt] = true}
                            RebuildOptions()
                            Overlay.Visible = false
                            Arrow.Text = "▾"
                        end
                        UpdateSelectedLabel()
                        if cfg.Flag then Lib.Flags[cfg.Flag] = multi and selected or opt end
                        pcall(function() callback(multi and selected or opt) end)
                    end)
                    table.insert(optionButtons, OBtn)
                end
                OScroll.CanvasSize = UDim2.new(0, 0, 0, #list * optionHeight)
            end
            RebuildOptions()

            local open = false
            local function CloseOverlay()
                open = false
                Overlay.Visible = false
                Arrow.Text = "▾"
            end
            local function OpenOverlay()
                open = true
                local visibleCount = math.min(#list, maxVisible)
                Overlay.Position = UDim2.fromOffset(DFrame.AbsolutePosition.X, DFrame.AbsolutePosition.Y + DFrame.AbsoluteSize.Y + 4)
                Overlay.Size = UDim2.fromOffset(DFrame.AbsoluteSize.X, math.max(visibleCount, 1) * optionHeight)
                Overlay.Visible = true
                Arrow.Text = "▴"
            end

            Click.MouseButton1Click:Connect(function()
                if open then CloseOverlay() else OpenOverlay() end
            end)

            Lib:Track(UserInputService.InputBegan:Connect(function(input)
                if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mousePos = UserInputService:GetMouseLocation()
                    local oPos, oSize = Overlay.AbsolutePosition, Overlay.AbsoluteSize
                    local inOverlay = mousePos.X >= oPos.X and mousePos.X <= oPos.X + oSize.X and mousePos.Y >= oPos.Y and mousePos.Y <= oPos.Y + oSize.Y
                    local dPos, dSize = DFrame.AbsolutePosition, DFrame.AbsoluteSize
                    local inDropdown = mousePos.X >= dPos.X and mousePos.X <= dPos.X + dSize.X and mousePos.Y >= dPos.Y and mousePos.Y <= dPos.Y + dSize.Y
                    if not inOverlay and not inDropdown then
                        CloseOverlay()
                    end
                end
            end))

            Lib:Track(Page:GetPropertyChangedSignal("Visible"):Connect(function()
                if not Page.Visible then CloseOverlay() end
            end))

            Lib:RegisterSearchable(DFrame, text, Page)
            if cfg.Tooltip then BindTooltip(DFrame, cfg.Tooltip, ScreenGui) end
            if cfg.Flag then
                Lib.Flags[cfg.Flag] = multi and selected or default
                Lib.FlagObjects[cfg.Flag] = {
                    Get = function() return multi and selected or default end,
                    Set = function(v)
                        if multi and type(v) == "table" then
                            selected = v
                        else
                            selected = {[v] = true}
                        end
                        RebuildOptions()
                        UpdateSelectedLabel()
                    end
                }
            end

            function Elements:SetDropdownOptions(newList)
                list = newList
                RebuildOptions()
            end

            return Elements
        end

