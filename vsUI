            Instance.new("UICorner", CFrame).CornerRadius = UDim.new(0, 6)

            local L = Instance.new("TextLabel", CFrame)
            L.Size = UDim2.new(0.6, 0, 1, 0)
            L.Position = UDim2.fromOffset(10, 0)
            L.BackgroundTransparency = 1
            L.Text = text
            L.TextColor3 = Theme.Text
            L.Font = Enum.Font.GothamMedium
            L.TextSize = 11
            L.TextXAlignment = Enum.TextXAlignment.Left

            local Swatch = Instance.new("TextButton", CFrame)
            Swatch.Size = UDim2.fromOffset(40, 20)
            Swatch.Position = UDim2.new(1, -50, 0.5, -10)
            Swatch.BackgroundColor3 = default
            Swatch.Text = ""
            Swatch.AutoButtonColor = false
            Instance.new("UICorner", Swatch).CornerRadius = UDim.new(0, 4)
            local swStroke = Instance.new("UIStroke", Swatch)
            swStroke.Color = Theme.Border
            swStroke.Transparency = 0.3

            local Overlay = Instance.new("Frame", ScreenGui)
            Overlay.Name = "vsUI_ColorOverlay"
            Overlay.BackgroundColor3 = Theme.Sidebar
            Overlay.Size = UDim2.fromOffset(180, 110)
            Overlay.Visible = false
            Overlay.ZIndex = 500
            Instance.new("UICorner", Overlay).CornerRadius = UDim.new(0, 6)
            local ocStroke = Instance.new("UIStroke", Overlay)
            ocStroke.Color = Theme.Accent
            ocStroke.Transparency = 0.2

            local r, g, b = default.R * 255, default.G * 255, default.B * 255
            local sliders = {}
            local function BuildChannel(labelText, index, val)
                local row = Instance.new("Frame", Overlay)
                row.Size = UDim2.new(1, -16, 0, 26)
                row.Position = UDim2.fromOffset(8, 8 + (index - 1) * 30)
                row.BackgroundTransparency = 1

                local rl = Instance.new("TextLabel", row)
                rl.Size = UDim2.fromOffset(14, 20)
                rl.BackgroundTransparency = 1
                rl.Text = labelText
                rl.TextColor3 = Theme.Text
                rl.Font = Enum.Font.GothamBold
                rl.TextSize = 11

                local bar = Instance.new("Frame", row)
                bar.Size = UDim2.new(1, -50, 0, 4)
                bar.Position = UDim2.fromOffset(20, 9)
                bar.BackgroundColor3 = Color3.fromRGB(45, 35, 65)
                Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

                local fill = Instance.new("Frame", bar)
                fill.Size = UDim2.fromScale(val / 255, 1)
                fill.BackgroundColor3 = Theme.Accent
                Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

                local vl = Instance.new("TextLabel", row)
                vl.Size = UDim2.fromOffset(24, 20)
                vl.Position = UDim2.new(1, -24, 0, 0)
                vl.BackgroundTransparency = 1
                vl.Text = tostring(math.floor(val))
                vl.TextColor3 = Theme.TextSecondary
                vl.Font = Enum.Font.Gotham
                vl.TextSize = 10

                local dragging = false
                local function Update(input)
                    local mx = input and input.Position.X or UserInputService:GetMouseLocation().X
                    local p = math.clamp((mx - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    fill.Size = UDim2.fromScale(p, 1)
                    local newVal = p * 255
                    vl.Text = tostring(math.floor(newVal))
                    sliders[index] = newVal
                    local col = Color3.fromRGB(math.floor(sliders[1]), math.floor(sliders[2]), math.floor(sliders[3]))
                    Swatch.BackgroundColor3 = col
                    if cfg.Flag then Lib.Flags[cfg.Flag] = col end
                    pcall(function() callback(col) end)
                end
                sliders[index] = val

                Lib:Track(row.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; Update(i) end
                end))
                Lib:Track(UserInputService.InputChanged:Connect(function(i)
                    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then Update(i) end
                end))
                Lib:Track(UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end))
            end
            BuildChannel("R", 1, r)
            BuildChannel("G", 2, g)
            BuildChannel("B", 3, b)

            local open = false
            Swatch.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    Overlay.Position = UDim2.fromOffset(Swatch.AbsolutePosition.X - 140, Swatch.AbsolutePosition.Y + 26)
                end
                Overlay.Visible = open
            end)

            Lib:Track(UserInputService.InputBegan:Connect(function(input)
                if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mousePos = UserInputService:GetMouseLocation()
                    local oPos, oSize = Overlay.AbsolutePosition, Overlay.AbsoluteSize
                    local inOverlay = mousePos.X >= oPos.X and mousePos.X <= oPos.X + oSize.X and mousePos.Y >= oPos.Y and mousePos.Y <= oPos.Y + oSize.Y
                    local sPos, sSize = Swatch.AbsolutePosition, Swatch.AbsoluteSize
                    local inSwatch = mousePos.X >= sPos.X and mousePos.X <= sPos.X + sSize.X and mousePos.Y >= sPos.Y and mousePos.Y <= sPos.Y + sSize.Y
                    if not inOverlay and not inSwatch then
                        open = false
                        Overlay.Visible = false
                    end
                end
            end))

            Lib:RegisterSearchable(CFrame, text, Page)
            if cfg.Tooltip then BindTooltip(L, cfg.Tooltip, ScreenGui) end
            if cfg.Flag then
                Lib.Flags[cfg.Flag] = default
                Lib.FlagObjects[cfg.Flag] = {
                    Get = function() return Swatch.BackgroundColor3 end,
                    Set = function(v)
                        Swatch.BackgroundColor3 = v
                    end
                }
            end
            return Elements
        end

        -- 便捷方法: 一键添加 保存/读取配置 按钮
        function Elements:AddConfigButtons()
            Elements:AddButton({Text = "保存配置", Callback = function() Lib:SaveConfig() end})
            Elements:AddButton({Text = "读取配置", Callback = function() Lib:LoadConfig() end})
            return Elements
        end

        Lib.Tabs[name] = Elements
        return Elements
    end

    return Lib
end

return vsUI
