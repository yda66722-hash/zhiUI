-- 安全的文件读写
local function SafeWriteFile(name, content)
    if writefile then
        local ok = pcall(writefile, name, content)
        return ok
    end
    return false
end

local function SafeReadFile(name)
    if isfile and readfile and isfile(name) then
        local ok, data = pcall(readfile, name)
        if ok then return data end
    end
    return nil
end

-- 改进的拖拽响应函数 (带屏幕边界保护)
local function MakeDraggable(dragPart, mainPart, clampToScreen)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local connections = {}

    connections.InputBegan = dragPart.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainPart.Position
        end
    end)

    connections.InputChanged = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if dragStart and startPos then
                local delta = input.Position - dragStart
                local newX = startPos.X.Offset + delta.X
                local newY = startPos.Y.Offset + delta.Y

                if clampToScreen then
                    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
                    if vp then
                        local size = mainPart.AbsoluteSize
                        newX = math.clamp(newX, -size.X * mainPart.AnchorPoint.X, vp.X - size.X * (1 - mainPart.AnchorPoint.X))
                        newY = math.clamp(newY, -size.Y * mainPart.AnchorPoint.Y, vp.Y - size.Y * (1 - mainPart.AnchorPoint.Y))
                    end
                end

                mainPart.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
            end
        end
    end)

    connections.InputEnded = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            dragStart = nil
            startPos = nil
        end
    end)

    return function()
        for _, conn in pairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
    end
end

-- 通知系统 (支持类型着色: info / success / warning / error)
function vsUI:Notify(title, desc, duration, notifyType)
    local NotifyGui = Parent:FindFirstChild("vsUI_Notify")
    if not NotifyGui then
        NotifyGui = Instance.new("ScreenGui", Parent)
        NotifyGui.Name = "vsUI_Notify"
        NotifyGui.ResetOnSpawn = false
        local Layout = Instance.new("UIListLayout", NotifyGui)
        Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        Layout.Padding = UDim.new(0, 10)

        local Pad = Instance.new("UIPadding", NotifyGui)
        Pad.PaddingBottom = UDim.new(0, 20)
        Pad.PaddingRight = UDim.new(0, 20)
    end

    local accentColor = Theme.Accent
    if notifyType == "success" then accentColor = Theme.Success
    elseif notifyType == "warning" then accentColor = Theme.Warning
    elseif notifyType == "error" then accentColor = Theme.Error end

    local Notif = Instance.new("Frame", NotifyGui)
    Notif.Size = UDim2.fromOffset(240, 0)
    Notif.BackgroundColor3 = Theme.Main
    Notif.BackgroundTransparency = 0.1
    Notif.ClipsDescendants = true
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 8)

    local Stroke = Instance.new("UIStroke", Notif)
    Stroke.Color = accentColor
    Stroke.Transparency = 0.4
    Stroke.Thickness = 1.2

    local Bar = Instance.new("Frame", Notif)
    Bar.Size = UDim2.new(0, 3, 1, 0)
    Bar.BackgroundColor3 = accentColor
    Bar.BorderSizePixel = 0

    local T = Instance.new("TextLabel", Notif)
    T.Size = UDim2.new(1, -24, 0, 22)
    T.Position = UDim2.fromOffset(12, 6)
    T.Text = title or "通知"
    T.TextColor3 = accentColor
    T.Font = Enum.Font.GothamBold
    T.TextSize = 12
    T.BackgroundTransparency = 1
    T.TextXAlignment = Enum.TextXAlignment.Left

    local D = Instance.new("TextLabel", Notif)
    D.Size = UDim2.new(1, -24, 0, 30)
    D.Position = UDim2.fromOffset(12, 26)
    D.Text = desc or ""
    D.TextColor3 = Theme.Text
    D.Font = Enum.Font.Gotham
    D.TextSize = 11
    D.BackgroundTransparency = 1
    D.TextXAlignment = Enum.TextXAlignment.Left
    D.TextWrapped = true

    TweenService:Create(Notif, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(240, 64)}):Play()
    task.delay(duration or 3, function()
        if Notif and Notif.Parent then
            local tw = TweenService:Create(Notif, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.fromOffset(240, 0)})
            tw:Play()
            tw.Completed:Connect(function() Notif:Destroy() end)
        end
    end)
end

-- BindTooltip
local function BindTooltip(element, text, parentGui)
    if not text or text == "" then return end
    local tip
    element.MouseEnter:Connect(function()
        if tip then tip:Destroy() end
        tip = Instance.new("TextLabel")
        tip.Name = "vsUI_Tooltip"
        tip.Parent = parentGui
        tip.AutomaticSize = Enum.AutomaticSize.X
        tip.Size = UDim2.fromOffset(0, 22)
        tip.BackgroundColor3 = Theme.Sidebar
        tip.BackgroundTransparency = 0.1
        tip.TextColor3 = Theme.Text
        tip.Font = Enum.Font.Gotham
        tip.TextSize = 11
        tip.Text = "  " .. text .. "  "
        tip.ZIndex = 1000
        Instance.new("UICorner", tip).CornerRadius = UDim.new(0, 4)
        local st = Instance.new("UIStroke", tip)
        st.Color = Theme.Accent
        st.Transparency = 0.6
    end)
    element.MouseMoved:Connect(function(x, y)
        if tip then
            tip.Position = UDim2.fromOffset(x + 16, y + 16)
        end
    end)
    element.MouseLeave:Connect(function()
        if tip then tip:Destroy(); tip = nil end
    end)
end

-- ContextMenu 右键菜单
function vsUI:BindContextMenu(element, items, parentGui)
    local menu
    local function CloseMenu()
        if menu then menu:Destroy(); menu = nil end
    end
    element.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            CloseMenu()
            local mousePos = UserInputService:GetMouseLocation()
            menu = Instance.new("Frame")
            menu.Name = "vsUI_ContextMenu"
            menu.Parent = parentGui
            menu.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
            menu.Size = UDim2.fromOffset(140, #items * 26)
            menu.BackgroundColor3 = Theme.Sidebar
            menu.ZIndex = 600
            Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 6)
            local st = Instance.new("UIStroke", menu)
            st.Color = Theme.Accent
            st.Transparency = 0.5

            local layout = Instance.new("UIListLayout", menu)
            layout.SortOrder = Enum.SortOrder.LayoutOrder

            for _, item in ipairs(items) do
                local opt = Instance.new("TextButton", menu)
                opt.Size = UDim2.new(1, 0, 0, 26)
                opt.BackgroundTransparency = 1
                opt.Text = "  " .. (item.Text or "")
                opt.TextColor3 = Theme.Text
                opt.Font = Enum.Font.Gotham
                opt.TextSize = 12
                opt.TextXAlignment = Enum.TextXAlignment.Left
                opt.ZIndex = 601
                opt.MouseButton1Click:Connect(function()
                    CloseMenu()
                    pcall(function() (item.Callback or function() end)() end)
                end)
            end

            task.delay(0.05, function()
                local conn
                conn = UserInputService.InputBegan:Connect(function(i2)
                    if i2.UserInputType == Enum.UserInputType.MouseButton1 then
                        CloseMenu()
                        if conn then conn:Disconnect() end
                    end
                end)
            end)
        end
    end)
end

function vsUI:CreateWindow(config)
    local Lib = { CurrentTab = nil, Tabs = {}, TabButtons = {}, Connections = {}, Flags = {}, FlagObjects = {}, ConfigName = (type(config) == "table" and config.ConfigName) or "vsUI_config" }
    local TitleText = (type(config) == "table" and config.Title) or (type(config) == "string" and config) or "vsUI 控制面板"

    if type(config) == "table" and config.Theme then
        local preset = ThemePresets[config.Theme]
        if preset then for k, v in pairs(preset) do Theme[k] = v end end
    end

    -- 统一的连接/清理管理器
    function Lib:Track(x)
        table.insert(Lib.Connections, x)
        return x
    end

    local ScreenGui = Instance.new("ScreenGui", Parent)
    ScreenGui.Name = "vsUI_" .. math.floor(tick() * 1000) .. "_" .. math.random(1000, 9999)
    ScreenGui.ResetOnSpawn = false
    ScreenGui.DisplayOrder = 999
    Lib.ScreenGui = ScreenGui

    local UIScale = Instance.new("UIScale", ScreenGui)
    local function ScaleAdjust()
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
        if not vp then return end
        if vp.X < 600 then
            UIScale.Scale = 0.65
        elseif vp.X < 900 then
            UIScale.Scale = 0.8
        else
            UIScale.Scale = 0.95
        end
    end
    ScaleAdjust()
    Lib:Track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        ScaleAdjust()
        if workspace.CurrentCamera then
            Lib:Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(ScaleAdjust))
        end
    end))
    if workspace.CurrentCamera then
        Lib:Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(ScaleAdjust))
    end

    -- 窗口尺寸放大: 680x430 (原 540x330)
    local MIN_SIZE = Vector2.new(480, 300)
    local MAX_SIZE = Vector2.new(1000, 700)

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.fromOffset(680, 430)
    Main.Position = UDim2.fromScale(0.5, 0.45)
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundColor3 = Theme.Main
    Main.BackgroundTransparency = Theme.Trans
    Main.ClipsDescendants = true
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)

    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Color = Theme.Border
    MainStroke.Transparency = Theme.BorderTrans

    local OriginalSize = Main.Size -- 记录展开时的完整尺寸，供最小化/收起还原使用

    local dragCleaner = MakeDraggable(Main, Main, true)
    Lib:Track({Disconnect = dragCleaner})
    Lib.Main = Main

    -- 顶栏
    local TopBar = Instance.new("Frame", Main)
    TopBar.Size = UDim2.new(1, 0, 0, 36)
    TopBar.BackgroundTransparency = 1

    local TitleLabel = Instance.new("TextLabel", TopBar)
    TitleLabel.Size = UDim2.new(0.6, 0, 1, 0)
    TitleLabel.Position = UDim2.fromOffset(65, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = TitleText
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local ToggleKey = (type(config) == "table" and config.ToggleKey) or Enum.KeyCode.RightControl
    local Colors = {Theme.Error, Theme.Warning, Theme.Success}
    local minimized = false

    -- ===== 黄色按钮: 收起整个窗口 + 生成悬浮恢复按钮 =====
    local RestoreButton = nil

    local function ShowRestoreButton()
        if RestoreButton then return end
        RestoreButton = Instance.new("TextButton", ScreenGui)
        RestoreButton.Name = "vsUI_RestoreButton"
        RestoreButton.Size = UDim2.fromOffset(46, 46)
        RestoreButton.Position = UDim2.fromOffset(20, 20)
        RestoreButton.BackgroundColor3 = Theme.Accent
        RestoreButton.Text = "≡"
        RestoreButton.TextColor3 = Theme.Text
        RestoreButton.Font = Enum.Font.GothamBold
        RestoreButton.TextSize = 20
        RestoreButton.AutoButtonColor = false
        RestoreButton.ZIndex = 900
        Instance.new("UICorner", RestoreButton).CornerRadius = UDim.new(1, 0)

        local rStroke = Instance.new("UIStroke", RestoreButton)
        rStroke.Color = Theme.Border
        rStroke.Transparency = 0.3
        rStroke.Thickness = 1.5

        RestoreButton.Size = UDim2.fromOffset(0, 0)
        TweenService:Create(RestoreButton, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(46, 46)}):Play()

        local restoreCleaner = MakeDraggable(RestoreButton, RestoreButton, true)
        Lib:Track({Disconnect = restoreCleaner})

        BindTooltip(RestoreButton, "点击展开面板 (或按 " .. ToggleKey.Name .. ")", ScreenGui)
    end

    local function HideRestoreButton()
        if RestoreButton then
            local btn = RestoreButton
            RestoreButton = nil
            local tw = TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0, 0)})
            tw:Play()
            tw.Completed:Connect(function() btn:Destroy() end)
        end
    end

    function Lib:CollapseUI()
        if not Main.Visible then return end
        minimized = false
        local tw = TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(Main.Size.X.Offset, 0),
            BackgroundTransparency = 1
        })
        tw:Play()
        tw.Completed:Connect(function()
            Main.Visible = false
            Main.Size = OriginalSize
            Main.BackgroundTransparency = Theme.Trans
            ShowRestoreButton()
        end)
    end

    function Lib:ExpandUI()
        HideRestoreButton()
        Main.Visible = true
        Main.BackgroundTransparency = Theme.Trans
        Main.Size = UDim2.fromOffset(Main.Size.X.Offset, 0)
        TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = OriginalSize
        }):Play()
    end

    if type(config) == "table" and config.EnableToggleButton then
        RestoreButton.MouseButton1Click:Connect(function() Lib:ExpandUI() end)
    end

    Lib:Track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == ToggleKey then
            if Main.Visible then
                Lib:CollapseUI()
            else
                Lib:ExpandUI()
            end
        end
    end))

    for i, color in ipairs(Colors) do
        local b = Instance.new("TextButton", TopBar)
        b.Size = UDim2.fromOffset(10, 10)
        b.Position = UDim2.fromOffset(14 + (i - 1) * 16, 13)
        b.BackgroundColor3 = color
        b.Text = ""
        b.AutoButtonColor = false
        Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)

        if i == 1 then
            -- 红色: 关闭/销毁
            Lib:Track(b.MouseButton1Click:Connect(function() Lib:Destroy() end))
            BindTooltip(b, "关闭/销毁", ScreenGui)
        elseif i == 2 then
            -- 黄色: 整个窗口收起 + 悬浮恢复按钮
            Lib:Track(b.MouseButton1Click:Connect(function() Lib:CollapseUI() end))
            BindTooltip(b, "隐藏面板 (点击后可用悬浮按钮或 " .. ToggleKey.Name .. " 恢复)", ScreenGui)
        else
            -- 绿色: 最小化为标题栏
            Lib:Track(b.MouseButton1Click:Connect(function()
                minimized = not minimized
                if minimized then
                    TweenService:Create(Main, TweenInfo.new(0.25), {Size = UDim2.fromOffset(Main.Size.X.Offset, 36)}):Play()
                else
                    TweenService:Create(Main, TweenInfo.new(0.25), {Size = OriginalSize}):Play()
                end
            end))
            BindTooltip(b, "最小化", ScreenGui)
        end
    end

    -- 侧边栏
    local Sidebar = Instance.new("Frame", Main)
    Sidebar.Size = UDim2.new(0, 150, 1, -36)
    Sidebar.Position = UDim2.fromOffset(0, 36)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BackgroundTransparency = 0.2

    local SideLayout = Instance.new("UIListLayout", Sidebar)
    SideLayout.Padding = UDim.new(0, 5)
    SideLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    SideLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local SidePadding = Instance.new("UIPadding", Sidebar)
    SidePadding.PaddingTop = UDim.new(0, 8)

    -- 搜索框
    local SearchBox = Instance.new("TextBox", Sidebar)
    SearchBox.Size = UDim2.new(0.88, 0, 0, 26)
    SearchBox.LayoutOrder = -1
    SearchBox.BackgroundColor3 = Theme.Card
    SearchBox.BackgroundTransparency = 0.2
    SearchBox.PlaceholderText = "搜索功能..."
    SearchBox.Text = ""
    SearchBox.TextColor3 = Theme.Text
    SearchBox.PlaceholderColor3 = Theme.TextSecondary
    SearchBox.Font = Enum.Font.Gotham
    SearchBox.TextSize = 11
    SearchBox.ClearTextOnFocus = false
    Instance.new("UICorner", SearchBox).CornerRadius = UDim.new(0, 6)
    local SearchPad = Instance.new("UIPadding", SearchBox)
    SearchPad.PaddingLeft = UDim.new(0, 8)

    Lib.SearchableElements = {}
    Lib:Track(SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = SearchBox.Text:lower()
        for _, entry in ipairs(Lib.SearchableElements) do
            if entry.Page.Visible then
                if q == "" or entry.Text:lower():find(q, 1, true) then
                    entry.Instance.Visible = true
                else
                    entry.Instance.Visible = false
                end
            end
        end
    end))

    -- 主内容区
    local Container = Instance.new("Frame", Main)
    Container.Size = UDim2.new(1, -158, 1, -44)
    Container.Position = UDim2.fromOffset(153, 40)
    Container.BackgroundTransparency = 1

    -- 右下角拖拽缩放手柄
    local ResizeHandle = Instance.new("TextButton", Main)
    ResizeHandle.Size = UDim2.fromOffset(16, 16)
    ResizeHandle.Position = UDim2.new(1, -16, 1, -16)
    ResizeHandle.BackgroundTransparency = 1
    ResizeHandle.Text = "◢"
    ResizeHandle.TextColor3 = Theme.TextSecondary
    ResizeHandle.Font = Enum.Font.GothamBold
    ResizeHandle.TextSize = 14
    ResizeHandle.AutoButtonColor = false
    ResizeHandle.ZIndex = 50
    do
        local resizing = false
        Lib:Track(ResizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
            end
        end))
        Lib:Track(UserInputService.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local mousePos = UserInputService:GetMouseLocation()
                local newW = math.clamp(mousePos.X - Main.AbsolutePosition.X, MIN_SIZE.X, MAX_SIZE.X)
                local newH = math.clamp(mousePos.Y - Main.AbsolutePosition.Y, MIN_SIZE.Y, MAX_SIZE.Y)
                Main.Size = UDim2.fromOffset(newW, newH)
                OriginalSize = Main.Size
            end
        end))
        Lib:Track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end))
    end

    function Lib:RegisterSearchable(frame, text, page)
        table.insert(Lib.SearchableElements, {Instance = frame, Text = text or "", Page = page})
    end

    function Lib:SetTheme(nameOrTable)
        local t = type(nameOrTable) == "table" and nameOrTable or ThemePresets[nameOrTable]
        if not t then return end
        for k, v in pairs(t) do Theme[k] = v end
        Main.BackgroundColor3 = Theme.Main
        MainStroke.Color = Theme.Border
        MainStroke.Transparency = Theme.BorderTrans
        Sidebar.BackgroundColor3 = Theme.Sidebar
        TitleLabel.TextColor3 = Theme.Text
        SearchBox.BackgroundColor3 = Theme.Card
        SearchBox.TextColor3 = Theme.Text
        SearchBox.PlaceholderColor3 = Theme.TextSecondary
        for _, btn in pairs(Lib.TabButtons) do
            btn.TextColor3 = (btn.BackgroundTransparency == 0.4) and Theme.Text or Theme.TextSecondary
        end
    end

    function Lib:SaveConfig(fileName)
        local HttpService = game:GetService("HttpService")
        local ok, encoded = pcall(function() return HttpService:JSONEncode(Lib.Flags) end)
        if ok then
            local success = SafeWriteFile((fileName or Lib.ConfigName) .. ".json", encoded)
            vsUI:Notify("配置保存", success and "成功导出配置文件" or "保存失败：环境不支持", 3, success and "success" or "error")
            return success
        end
        return false
    end

    function Lib:LoadConfig(fileName)
        local raw = SafeReadFile((fileName or Lib.ConfigName) .. ".json")
        if not raw then
            vsUI:Notify("配置读取", "未找到指定配置文件", 3, "warning")
            return false
        end
        local HttpService = game:GetService("HttpService")
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok or type(data) ~= "table" then
            vsUI:Notify("配置读取", "解析文件失败", 3, "error")
            return false
        end
        for flag, value in pairs(data) do
            Lib.Flags[flag] = value
            local obj = Lib.FlagObjects[flag]
            if obj and obj.Set then
                pcall(function() obj.Set(value) end)
            end
        end
