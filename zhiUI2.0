-- ========================================================
-- zhiUI 2.5 (完美尺寸 + 移动端自动拉伸 + 完整功能版)
-- ========================================================

local zhiUI = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local Parent = (gethui and gethui()) or CoreGui:FindFirstChild("RobloxGui") or game.Players.LocalPlayer:WaitForChild("PlayerGui")

-- 清理旧 UI
for _, v in pairs(Parent:GetChildren()) do
    if v.Name:sub(1, 6) == "zhiUI_" then 
        v:Destroy() 
    end
end

local Theme = {
    Main = Color3.fromRGB(20, 24, 38),
    Sidebar = Color3.fromRGB(13, 16, 27),
    Card = Color3.fromRGB(30, 37, 56),
    Accent = Color3.fromRGB(99, 102, 241),
    Text = Color3.fromRGB(255, 255, 255),
    TextSecondary = Color3.fromRGB(148, 163, 184),
    Border = Color3.fromRGB(255, 255, 255),
    BorderTrans = 0.92,
    Trans = 0.15
}

local function MakeDraggable(dragPart, mainPart)
    local dragging, dragStart, startPos
    dragPart.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainPart.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainPart.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

function zhiUI:Notify(title, desc, duration)
    local NotifyGui = Parent:FindFirstChild("zhiUI_Notify")
    if not NotifyGui then
        NotifyGui = Instance.new("ScreenGui", Parent)
        NotifyGui.Name = "zhiUI_Notify"
        local Layout = Instance.new("UIListLayout", NotifyGui)
        Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        Layout.Padding = UDim.new(0, 10)
    end

    local Notif = Instance.new("Frame", NotifyGui)
    Notif.Size = UDim2.fromOffset(240, 0)
    Notif.BackgroundColor3 = Theme.Main
    Notif.BackgroundTransparency = 0.1
    Notif.ClipsDescendants = true
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 10)

    local T = Instance.new("TextLabel", Notif)
    T.Size = UDim2.new(1, -20, 0, 25)
    T.Position = UDim2.fromOffset(12, 6)
    T.Text = title or "通知"
    T.TextColor3 = Theme.Accent
    T.Font = Enum.Font.GothamBold
    T.TextSize = 13
    T.BackgroundTransparency = 1
    T.TextXAlignment = Enum.TextXAlignment.Left

    local D = Instance.new("TextLabel", Notif)
    D.Size = UDim2.new(1, -20, 0, 30)
    D.Position = UDim2.fromOffset(12, 28)
    D.Text = desc or ""
    D.TextColor3 = Theme.Text
    D.Font = Enum.Font.Gotham
    D.TextSize = 11
    D.BackgroundTransparency = 1
    D.TextXAlignment = Enum.TextXAlignment.Left
    D.TextWrapped = true

    TweenService:Create(Notif, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Size = UDim2.fromOffset(240, 60)}):Play()
    task.delay(duration or 3, function()
        TweenService:Create(Notif, TweenInfo.new(0.4), {Size = UDim2.fromOffset(0, 60), BackgroundTransparency = 1}):Play()
        task.wait(0.4)
        Notif:Destroy()
    end)
end

function zhiUI:CreateWindow(config)
    local Lib = { CurrentTab = nil, Tabs = {} }
    local TitleText = (type(config) == "table" and config.Title) or (type(config) == "string" and config) or "zhiUI 控制面板"

    local ScreenGui = Instance.new("ScreenGui", Parent)
    ScreenGui.Name = "zhiUI_" .. math.random(1000, 9999)
    ScreenGui.ResetOnSpawn = false

    -- 主面板尺寸调整为适中的 560x340，确保手机端清晰且不遮挡操作
    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.fromOffset(560, 340)
    Main.Position = UDim2.fromScale(0.5, 0.45)
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundColor3 = Theme.Main
    Main.BackgroundTransparency = Theme.Trans
    Main.ClipsDescendants = true
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)
    
    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Color = Theme.Border
    MainStroke.Transparency = Theme.BorderTrans
    MakeDraggable(Main, Main)

    -- 顶部栏
    local TopBar = Instance.new("Frame", Main)
    TopBar.Size = UDim2.new(1, 0, 0, 40)
    TopBar.BackgroundTransparency = 1

    local TitleLabel = Instance.new("TextLabel", TopBar)
    TitleLabel.Size = UDim2.new(0.6, 0, 1, 0)
    TitleLabel.Position = UDim2.fromOffset(70, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = TitleText
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- 侧边栏
    local Sidebar = Instance.new("Frame", Main)
    Sidebar.Size = UDim2.new(0, 130, 1, -40)
    Sidebar.Position = UDim2.fromOffset(0, 40)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BackgroundTransparency = 0.2
    
    local SideLayout = Instance.new("UIListLayout", Sidebar)
    SideLayout.Padding = UDim.new(0, 6)
    SideLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    -- 内容主容器
    local Container = Instance.new("Frame", Main)
    Container.Size = UDim2.new(1, -140, 1, -50)
    Container.Position = UDim2.fromOffset(135, 45)
    Container.BackgroundTransparency = 1

    local function createTabInternal(selfObj, tabConfig)
        local name = type(tabConfig) == "table" and tabConfig.Name or tostring(tabConfig)
        local Elements = {}

        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(0.9, 0, 0, 36)
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = name
        TabBtn.TextColor3 = Theme.TextSecondary
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextSize = 13

        -- 页面容器
        local Page = Instance.new("ScrollingFrame", Container)
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.Visible = false
        Page.ScrollBarThickness = 4
        Page.ScrollBarImageColor3 = Theme.Accent
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)
        
        local PageLayout = Instance.new("UIListLayout", Page)
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        
        -- 核心修改：动态实时计算滚动区域高度，确保按钮不丢失
        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.fromOffset(0, PageLayout.AbsoluteContentSize.Y + 20)
        end)

        TabBtn.MouseButton1Click:Connect(function()
            for _, v in pairs(Container:GetChildren()) do 
                if v:IsA("ScrollingFrame") then v.Visible = false end 
            end
            for _, v in pairs(Sidebar:GetChildren()) do 
                if v:IsA("TextButton") then v.TextColor3 = Theme.TextSecondary end 
            end
            Page.Visible = true
            TabBtn.TextColor3 = Theme.Text
        end)

        if not Lib.CurrentTab then 
            Lib.CurrentTab = Page
            Page.Visible = true
            TabBtn.TextColor3 = Theme.Text 
        end

        -- 添加按钮
        function Elements:AddButton(cfg)
            local text = type(cfg) == "table" and cfg.Text or tostring(cfg)
            local callback = type(cfg) == "table" and cfg.Callback or function() end

            local Btn = Instance.new("TextButton", Page)
            Btn.Size = UDim2.new(0.96, 0, 0, 38)
            Btn.BackgroundColor3 = Theme.Card
            Btn.BackgroundTransparency = 0.2
            Btn.Text = text
            Btn.TextColor3 = Theme.Text
            Btn.Font = Enum.Font.GothamBold
            Btn.TextSize = 12
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
            
            local stroke = Instance.new("UIStroke", Btn)
            stroke.Color = Theme.Border
            stroke.Transparency = Theme.BorderTrans

            Btn.MouseButton1Click:Connect(callback)
            return Elements
        end

        -- 添加开关
        function Elements:AddToggle(cfg)
            local text = type(cfg) == "table" and cfg.Text or tostring(cfg)
            local state = type(cfg) == "table" and cfg.Default or false
            local callback = type(cfg) == "table" and cfg.Callback or function() end

            local TFrame = Instance.new("Frame", Page)
            TFrame.Size = UDim2.new(0.96, 0, 0, 38)
            TFrame.BackgroundColor3 = Theme.Card
            TFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", TFrame).CornerRadius = UDim.new(0, 6)

            local L = Instance.new("TextLabel", TFrame)
            L.Size = UDim2.new(0.65, 0, 1, 0)
            L.Position = UDim2.fromOffset(12, 0)
            L.BackgroundTransparency = 1
            L.Text = text
            L.TextColor3 = Theme.Text
            L.Font = Enum.Font.GothamMedium
            L.TextSize = 12
            L.TextXAlignment = Enum.TextXAlignment.Left

            local S = Instance.new("TextButton", TFrame)
            S.Size = UDim2.fromOffset(38, 20)
            S.Position = UDim2.new(1, -48, 0.5, -10)
            S.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 60, 80)
            S.Text = ""
            Instance.new("UICorner", S).CornerRadius = UDim.new(1, 0)

            local D = Instance.new("Frame", S)
            D.Size = UDim2.fromOffset(16, 16)
            D.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            D.BackgroundColor3 = Theme.Text
            Instance.new("UICorner", D).CornerRadius = UDim.new(1, 0)

            S.MouseButton1Click:Connect(function()
                state = not state
                D.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
                S.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 60, 80)
                callback(state)
            end)
            return Elements
        end

        -- 添加滑动条
        function Elements:AddSlider(cfg)
            local text = cfg.Text or "Slider"
            local min = cfg.Min or 0
            local max = cfg.Max or 100
            local default = math.clamp(cfg.Default or min, min, max)
            local callback = cfg.Callback or function() end

            local SFrame = Instance.new("Frame", Page)
            SFrame.Size = UDim2.new(0.96, 0, 0, 46)
            SFrame.BackgroundColor3 = Theme.Card
            SFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", SFrame).CornerRadius = UDim.new(0, 6)

            local L = Instance.new("TextLabel", SFrame)
            L.Size = UDim2.new(0.6, 0, 0, 20)
            L.Position = UDim2.fromOffset(12, 4)
            L.BackgroundTransparency = 1
            L.Text = text
            L.TextColor3 = Theme.Text
            L.Font = Enum.Font.GothamMedium
            L.TextSize = 12
            L.TextXAlignment = Enum.TextXAlignment.Left

            local ValL = Instance.new("TextLabel", SFrame)
            ValL.Size = UDim2.new(0.3, 0, 0, 20)
            ValL.Position = UDim2.new(0.7, -12, 0, 4)
            ValL.BackgroundTransparency = 1
            ValL.Text = tostring(default)
            ValL.TextColor3 = Theme.TextSecondary
            ValL.Font = Enum.Font.GothamBold
            ValL.TextSize = 11
            ValL.TextXAlignment = Enum.TextXAlignment.Right

            local Bar = Instance.new("Frame", SFrame)
            Bar.Size = UDim2.new(0.92, 0, 0, 5)
            Bar.Position = UDim2.new(0.04, 0, 0, 30)
            Bar.BackgroundColor3 = Color3.fromRGB(45, 55, 75)
            Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
            Fill.BackgroundColor3 = Theme.Accent
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local dragging = false
            local function Update()
                local p = math.clamp((UserInputService:GetMouseLocation().X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                Fill.Size = UDim2.fromScale(p, 1)
                local val = math.floor(min + (max - min) * p)
                ValL.Text = tostring(val)
                callback(val)
            end

            SFrame.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Update()
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    Update()
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            return Elements
        end

        -- 添加标签与分割线
        function Elements:AddLabel(text)
            local L = Instance.new("TextLabel", Page)
            L.Size = UDim2.new(0.96, 0, 0, 22)
            L.BackgroundTransparency = 1
            L.Text = text or ""
            L.TextColor3 = Theme.TextSecondary
            L.Font = Enum.Font.GothamItalic
            L.TextSize = 11
            L.TextXAlignment = Enum.TextXAlignment.Left
            return Elements
        end

        function Elements:AddDivider()
            local D = Instance.new("Frame", Page)
            D.Size = UDim2.new(0.96, 0, 0, 2)
            D.BackgroundColor3 = Theme.Accent
            D.BackgroundTransparency = 0.7
            return Elements
        end

        return Elements
    end

    Lib.AddTab = createTabInternal
    return Lib
end

-- ========================================================
-- 演示与面板生成逻辑
-- ========================================================

local Window = zhiUI:CreateWindow({
    Title = "zhiUI 控制面板"
})

local MainTab = Window:AddTab({ Name = "主页功能" })
local VisualTab = Window:AddTab({ Name = "视觉调节" })

-- 主页功能区添加
MainTab:AddLabel("—— 常用工具 ——")

MainTab:AddButton({
    Text = "点击生成提示",
    Callback = function()
        zhiUI:Notify("成功", "功能被正确触发！", 3)
    end
})

MainTab:AddToggle({
    Text = "自动捡宝箱 (Auto Farm)",
    Default = false,
    Callback = function(state)
        zhiUI:Notify("自动挂机", "当前状态: " .. tostring(state), 2)
    end
})

MainTab:AddDivider()

MainTab:AddButton({
    Text = "提升玩家速度至 50",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = 50
            zhiUI:Notify("速度提升", "WalkSpeed 已设为 50", 2)
        end
    end
})

-- 视觉调节区添加
VisualTab:AddLabel("—— 参数调节 ——")

VisualTab:AddSlider({
    Text = "自定义移动速度",
    Min = 16,
    Max = 200,
    Default = 16,
    Callback = function(val)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = val
        end
    end
})