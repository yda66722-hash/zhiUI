-- ==========================================
--               vsUI Framework
--               Full Component
-- ==========================================

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

-- 自动清理旧 UI 实例（防重复加载）
if CoreGui:FindFirstChild("vsUI_Screen") then
    CoreGui.vsUI_Screen:Destroy()
end

local vsUI = {}
vsUI.__index = vsUI

-- 全局主题色彩配置
local Theme = {
    Background = Color3.fromRGB(20, 20, 24),
    Sidebar    = Color3.fromRGB(15, 15, 18),
    Card       = Color3.fromRGB(28, 28, 34),
    CardHover  = Color3.fromRGB(36, 36, 44),
    Accent     = Color3.fromRGB(0, 162, 255),
    Text       = Color3.fromRGB(240, 240, 245),
    TextSub    = Color3.fromRGB(140, 140, 150),
    Outline    = Color3.fromRGB(40, 40, 48)
}

-- 全局 Toast 通知系统
function vsUI:Notify(config)
    config = config or {}
    local title = config.Title or "通知"
    local content = config.Content or ""
    local duration = config.Duration or 3

    local screen = CoreGui:FindFirstChild("vsUI_Screen")
    if not screen then return end

    local container = screen:FindFirstChild("ToastContainer")
    if not container then
        container = Instance.new("Frame")
        container.Name = "ToastContainer"
        container.Size = UDim2.new(0, 240, 1, -20)
        container.Position = UDim2.new(1, -250, 0, 10)
        container.BackgroundTransparency = 1
        container.Parent = screen

        local layout = Instance.new("UIListLayout", container)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.Padding = UDim.new(0, 8)
    end

    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(1, 0, 0, 55)
    toast.BackgroundColor3 = Theme.Card
    toast.BackgroundTransparency = 1
    toast.BorderSizePixel = 0
    toast.Position = UDim2.new(1, 60, 0, 0)
    toast.ClipsDescendants = true
    toast.Parent = container

    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    -- 蓝色描边特效已移除，改为柔和的纯色卡片背景

    local tTitle = Instance.new("TextLabel")
    tTitle.Size = UDim2.new(1, -20, 0, 20)
    tTitle.Position = UDim2.new(0, 10, 0, 6)
    tTitle.BackgroundTransparency = 1
    tTitle.TextTransparency = 1
    tTitle.Text = title
    tTitle.TextColor3 = Theme.Text
    tTitle.TextSize = 13
    tTitle.Font = Enum.Font.GothamBold
    tTitle.TextXAlignment = Enum.TextXAlignment.Left
    tTitle.Parent = toast

    local tText = Instance.new("TextLabel")
    tText.Size = UDim2.new(1, -20, 0, 22)
    tText.Position = UDim2.new(0, 10, 0, 26)
    tText.BackgroundTransparency = 1
    tText.TextTransparency = 1
    tText.Text = content
    tText.TextColor3 = Theme.TextSub
    tText.TextSize = 12
    tText.Font = Enum.Font.Gotham
    tText.TextXAlignment = Enum.TextXAlignment.Left
    tText.Parent = toast

    -- 更顺滑的入场动画（轻微回弹，取代生硬的线性滑入）
    local enterInfo = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(toast, enterInfo, {Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0}):Play()
    TweenService:Create(tTitle, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
    TweenService:Create(tText, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

    task.delay(duration, function()
        local exitInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        TweenService:Create(toast, exitInfo, {Position = UDim2.new(1, 60, 0, 0), BackgroundTransparency = 1}):Play()
        TweenService:Create(tTitle, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
        local tween = TweenService:Create(tText, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {TextTransparency = 1})
        tween:Play()
        tween.Completed:Connect(function()
            toast:Destroy()
        end)
    end)
end

-- 创建主窗口
function vsUI.CreateWindow(titleText)
    local self = setmetatable({}, vsUI)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "vsUI_Screen"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = CoreGui
    self.ScreenGui = screenGui

    local normalSize = UDim2.new(0, 560, 0, 380)
    local normalPos  = UDim2.new(0.5, -280, 0.5, -190)
    local maxSize    = UDim2.new(0, 760, 0, 500)
    local maxPos     = UDim2.new(0.5, -380, 0.5, -250)

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = normalSize
    mainFrame.Position = normalPos
    mainFrame.BackgroundColor3 = Theme.Background
    mainFrame.BorderSizePixel = 0
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = screenGui
    self.MainFrame = mainFrame

    Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)
    local mainStroke = Instance.new("UIStroke", mainFrame)
    mainStroke.Color = Theme.Outline
    mainStroke.Thickness = 1

    -- TopBar
    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, 0, 38)
    topBar.BackgroundColor3 = Theme.Sidebar
    topBar.BorderSizePixel = 0
    topBar.Parent = mainFrame

    Instance.new("UICorner", topBar).CornerRadius = UDim.new(0, 10)
    local topFix = Instance.new("Frame")
    topFix.Size = UDim2.new(1, 0, 0, 10)
    topFix.Position = UDim2.new(0, 0, 1, -10)
    topFix.BackgroundColor3 = Theme.Sidebar
    topFix.BorderSizePixel = 0
    topFix.Parent = topBar

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -110, 1, 0)
    titleLabel.Position = UDim2.new(0, 15, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = titleText or "vsUI Framework"
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextSize = 14
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = topBar

    -- ===== 窗口控制按钮（隐藏 / 放大 / 关闭）=====
    local function createControlBtn(iconText, order, hoverColor)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 24, 0, 24)
        btn.Position = UDim2.new(1, -30 - (order * 30), 0.5, -12)
        btn.BackgroundColor3 = Theme.Card
        btn.Text = iconText
        btn.TextColor3 = Theme.TextSub
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.Parent = topBar

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hoverColor or Theme.CardHover}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
        end)

        return btn
    end

    -- 关闭按钮
    local closeBtn = createControlBtn("✕", 0, Color3.fromRGB(200, 60, 60))
    closeBtn.MouseButton1Click:Connect(function()
        local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Size = UDim2.new(mainFrame.Size.X.Scale, 0, mainFrame.Size.Y.Scale, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        tween:Play()
        tween.Completed:Connect(function()
            screenGui:Destroy()
        end)
    end)

    -- 放大 / 还原按钮
    local isMaximized = false
    local maxBtn = createControlBtn("☐", 1)
    maxBtn.MouseButton1Click:Connect(function()
        isMaximized = not isMaximized
        local targetSize = isMaximized and maxSize or normalSize
        local targetPos = isMaximized and maxPos or normalPos
        local info = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        TweenService:Create(mainFrame, info, {Size = targetSize, Position = targetPos}):Play()
    end)

    -- 隐藏按钮 + 还原用的小型悬浮按钮
    local miniButton = Instance.new("TextButton")
    miniButton.Name = "vsUI_MiniButton"
    miniButton.Size = UDim2.new(0, 170, 0, 34)
    miniButton.Position = UDim2.new(0, 20, 0, 20)
    miniButton.BackgroundColor3 = Theme.Card
    miniButton.Text = "  " .. (titleText or "vsUI Framework")
    miniButton.TextColor3 = Theme.Text
    miniButton.TextSize = 13
    miniButton.Font = Enum.Font.GothamSemibold
    miniButton.TextXAlignment = Enum.TextXAlignment.Left
    miniButton.AutoButtonColor = false
    miniButton.Visible = false
    miniButton.Parent = screenGui

    Instance.new("UICorner", miniButton).CornerRadius = UDim.new(0, 8)
    local miniStroke = Instance.new("UIStroke", miniButton)
    miniStroke.Color = Theme.Outline
    miniStroke.Thickness = 1

    miniButton.MouseEnter:Connect(function()
        TweenService:Create(miniButton, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover}):Play()
    end)
    miniButton.MouseLeave:Connect(function()
        TweenService:Create(miniButton, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
    end)

    local hideBtn = createControlBtn("—", 2)
    hideBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = false
        miniButton.Visible = true
    end)

    miniButton.MouseButton1Click:Connect(function()
        miniButton.Visible = false
        mainFrame.Visible = true
    end)

    -- 小型悬浮按钮拖拽（方便玩家挪到不遮挡视野的位置）
    do
        local dragging, dragInput, dragStart, startPos
        miniButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = miniButton.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        miniButton.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                miniButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, 140, 1, -38)
    sidebar.Position = UDim2.new(0, 0, 0, 38)
    sidebar.BackgroundColor3 = Theme.Sidebar
    sidebar.BorderSizePixel = 0
    sidebar.Parent = mainFrame

    local sideLayout = Instance.new("UIListLayout", sidebar)
    sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sideLayout.Padding = UDim.new(0, 5)

    local sidePadding = Instance.new("UIPadding", sidebar)
    sidePadding.PaddingTop = UDim.new(0, 8)
    sidePadding.PaddingLeft = UDim.new(0, 8)
    sidePadding.PaddingRight = UDim.new(0, 8)

    -- Container
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -140, 1, -38)
    container.Position = UDim2.new(0, 140, 0, 38)
    container.BackgroundTransparency = 1
    container.Parent = mainFrame
    self.Container = container

    -- 拖拽机制（支持 Touch & Mouse）
    local dragging, dragInput, dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- RightShift 折叠 UI（与隐藏按钮共用同一套显示/隐藏逻辑）
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            if mainFrame.Visible then
                mainFrame.Visible = false
                miniButton.Visible = true
            else
                mainFrame.Visible = true
                miniButton.Visible = false
            end
        end
    end)

    self.Tabs = {}
    self.Sidebar = sidebar

    return self
end

-- 创建 Tab 标签页
function vsUI:CreateTab(tabName)
    local tabObj = {}

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 32)
    tabBtn.BackgroundColor3 = Theme.Card
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Theme.TextSub
    tabBtn.TextSize = 13
    tabBtn.Font = Enum.Font.GothamSemibold
    tabBtn.Parent = self.Sidebar

    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local tabContent = Instance.new("ScrollingFrame")
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.BorderSizePixel = 0
    tabContent.ScrollBarThickness = 3
    tabContent.ScrollBarImageColor3 = Theme.Accent
    tabContent.Visible = false
    tabContent.Parent = self.Container

    local contentLayout = Instance.new("UIListLayout", tabContent)
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Padding = UDim.new(0, 8)

    local contentPadding = Instance.new("UIPadding", tabContent)
    contentPadding.PaddingTop = UDim.new(0, 10)
    contentPadding.PaddingLeft = UDim.new(0, 10)
    contentPadding.PaddingRight = UDim.new(0, 10)
    contentPadding.PaddingBottom = UDim.new(0, 10)

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabContent.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 20)
    end)

    local function activate()
        for _, t in pairs(self.Tabs) do
            t.Content.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextColor3 = Theme.TextSub}):Play()
        end
        tabContent.Visible = true
        TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0, TextColor3 = Theme.Accent}):Play()
    end

    tabBtn.MouseButton1Click:Connect(activate)

    if #self.Tabs == 0 then
        activate()
    end

    tabObj.Button = tabBtn
    tabObj.Content = tabContent
    table.insert(self.Tabs, tabObj)

    -- ================= 组件库实现 =================

    -- 1. Section (分组标题)
    function tabObj:AddSection(text)
        local secLabel = Instance.new("TextLabel")
        secLabel.Size = UDim2.new(1, 0, 0, 20)
        secLabel.BackgroundTransparency = 1
        secLabel.Text = text
        secLabel.TextColor3 = Theme.Accent
        secLabel.TextSize = 12
        secLabel.Font = Enum.Font.GothamBold
        secLabel.TextXAlignment = Enum.TextXAlignment.Left
        secLabel.Parent = tabContent
    end

    -- 2. Button (普通按钮)
    function tabObj:AddButton(btnText, callback)
        callback = callback or function() end
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = Theme.Card
        btn.Text = btnText
        btn.TextColor3 = Theme.Text
        btn.TextSize = 13
        btn.Font = Enum.Font.Gotham
        btn.Parent = tabContent

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Theme.Outline

        btn.MouseButton1Click:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.CardHover}):Play()
            task.delay(0.1, function()
                TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Card}):Play()
            end)
            pcall(callback)
        end)
    end

    -- 3. Toggle (开关)
    function tabObj:AddToggle(toggleText, default, callback)
        callback = callback or function() end
        local state = default or false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = Theme.Card
        frame.Parent = tabContent

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Theme.Outline

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -60, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = toggleText
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 38, 0, 20)
        indicator.Position = UDim2.new(1, -48, 0.5, -10)
        indicator.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 50, 60)
        indicator.Parent = frame

        Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 14, 0, 14)
        dot.Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        dot.Parent = indicator

        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.Parent = frame

        btn.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(dot, TweenInfo.new(0.2), {
                Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            }):Play()
            TweenService:Create(indicator, TweenInfo.new(0.2), {
                BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 50, 60)
            }):Play()
            pcall(callback, state)
        end)
    end

    -- 4. Slider (数值滑动条)
    function tabObj:AddSlider(sliderText, min, max, default, callback)
        callback = callback or function() end
        local value = math.clamp(default or min, min, max)

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 48)
        frame.BackgroundColor3 = Theme.Card
        frame.Parent = tabContent

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Theme.Outline

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.7, 0, 0, 20)
        label.Position = UDim2.new(0, 10, 0, 6)
        label.BackgroundTransparency = 1
        label.Text = sliderText
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(0.3, -10, 0, 20)
        valLabel.Position = UDim2.new(0.7, 0, 0, 6)
        valLabel.BackgroundTransparency = 1
        valLabel.Text = tostring(value)
        valLabel.TextColor3 = Theme.TextSub
        valLabel.TextSize = 12
        valLabel.Font = Enum.Font.Gotham
        valLabel.TextXAlignment = Enum.TextXAlignment.Right
        valLabel.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -20, 0, 6)
        track.Position = UDim2.new(0, 10, 0, 32)
        track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        track.Parent = frame

        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Theme.Accent
        fill.Parent = track

        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local draggingSlider = false
        local function updateInput(input)
            local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * pos)
            valLabel.Text = tostring(value)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            pcall(callback, value)
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                updateInput(input)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateInput(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
    end

    -- 5. Dropdown (下拉选择框)
    function tabObj:AddDropdown(dropText, options, callback)
        callback = callback or function() end
        local expanded = false
        options = options or {}

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = Theme.Card
        frame.ClipsDescendants = true
        frame.Parent = tabContent

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Theme.Outline

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.6, 0, 0, 36)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = dropText
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local selectedText = Instance.new("TextLabel")
        selectedText.Size = UDim2.new(0.4, -25, 0, 36)
        selectedText.Position = UDim2.new(0.6, 0, 0, 0)
        selectedText.BackgroundTransparency = 1
        selectedText.Text = "请选择..."
        selectedText.TextColor3 = Theme.TextSub
        selectedText.TextSize = 12
        selectedText.Font = Enum.Font.Gotham
        selectedText.TextXAlignment = Enum.TextXAlignment.Right
        selectedText.Parent = frame

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(1, 0, 0, 36)
        toggleBtn.BackgroundTransparency = 1
        toggleBtn.Text = ""
        toggleBtn.Parent = frame

        local optContainer = Instance.new("Frame")
        optContainer.Size = UDim2.new(1, -20, 0, #options * 28)
        optContainer.Position = UDim2.new(0, 10, 0, 38)
        optContainer.BackgroundTransparency = 1
        optContainer.Parent = frame

        local optLayout = Instance.new("UIListLayout", optContainer)
        optLayout.SortOrder = Enum.SortOrder.LayoutOrder
        optLayout.Padding = UDim.new(0, 3)

        for _, opt in ipairs(options) do
            local oBtn = Instance.new("TextButton")
            oBtn.Size = UDim2.new(1, 0, 0, 25)
            oBtn.BackgroundColor3 = Theme.Background
            oBtn.Text = opt
            oBtn.TextColor3 = Theme.Text
            oBtn.TextSize = 12
            oBtn.Font = Enum.Font.Gotham
            oBtn.Parent = optContainer

            Instance.new("UICorner", oBtn).CornerRadius = UDim.new(0, 4)

            oBtn.MouseButton1Click:Connect(function()
                selectedText.Text = opt
                expanded = false
                TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 36)}):Play()
                pcall(callback, opt)
            end)
        end

        toggleBtn.MouseButton1Click:Connect(function()
            expanded = not expanded
            local targetHeight = expanded and (42 + #options * 28) or 36
            TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
        end)
    end

    -- 6. Keybind (快捷键绑定)
    function tabObj:AddKeybind(bindText, defaultKey, callback)
        callback = callback or function() end
        local currentKey = defaultKey or Enum.KeyCode.E
        local binding = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = Theme.Card
        frame.Parent = tabContent

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Theme.Outline

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = bindText
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local bindBtn = Instance.new("TextButton")
        bindBtn.Size = UDim2.new(0, 70, 0, 24)
        bindBtn.Position = UDim2.new(1, -80, 0.5, -12)
        bindBtn.BackgroundColor3 = Theme.Background
        bindBtn.Text = currentKey.Name
        bindBtn.TextColor3 = Theme.Accent
        bindBtn.TextSize = 12
        bindBtn.Font = Enum.Font.GothamBold
        bindBtn.Parent = frame

        Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 4)

        bindBtn.MouseButton1Click:Connect(function()
            binding = true
            bindBtn.Text = "请按键..."
        end)

        UserInputService.InputBegan:Connect(function(input, gpe)
            if binding and not gpe then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    bindBtn.Text = currentKey.Name
                    binding = false
                    pcall(callback, currentKey)
                end
            elseif not gpe and input.KeyCode == currentKey then
                pcall(callback, currentKey)
            end
        end)
    end

    -- 7. TextBox (输入框)
    function tabObj:AddTextBox(boxText, placeholder, callback)
        callback = callback or function() end

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 36)
        frame.BackgroundColor3 = Theme.Card
        frame.Parent = tabContent

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Theme.Outline

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.5, -10, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = boxText
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local box = Instance.new("TextBox")
        box.Size = UDim2.new(0.5, -10, 0, 24)
        box.Position = UDim2.new(0.5, 0, 0.5, -12)
        box.BackgroundColor3 = Theme.Background
        box.PlaceholderText = placeholder or "输入..."
        box.Text = ""
        box.TextColor3 = Theme.Text
        box.PlaceholderColor3 = Theme.TextSub
        box.TextSize = 12
        box.Font = Enum.Font.Gotham
        box.Parent = frame

        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

        box.FocusLost:Connect(function(enter)
            if enter then pcall(callback, box.Text) end
        end)
    end

    return tabObj
end

return vsUI